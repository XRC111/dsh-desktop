# 依赖与构建产物
node_modules/
out/
dist/
resources/dsh-runtime/

# 探测 / 临时目录
.probe/
*.log

# 构建期生成的图标（由 scripts/gen-assets.mjs 生成）
build/icon.ico
build/tray.png
build/icon-256.png

# ── 发版产物与本地运行时树（大文件，永不进 git；可由 release-v2.ps1 等脚本重建）──
build/hot-shell-*.tar
build/dsh-runtime*.tar*
build/dsh-runtime-patch-*.tar.gz*
build/dsh-runtime-manifest*.json*
build/plugins-*.tar.gz*
build/plugins-*.meta.json
build/plugins-*-parts/
build/rt-next/
build/rt-alpha/
# 其它运行时树（如 rt-020 实测树）与临时探测目录，统一按前缀忽略
build/rt-*/
# nightly 源码树（scripts/fetch-nightly.mjs 的临时克隆，1GB+）
build/harness-src/
build/probe-*/
build/api-diff*/
build/runtime-*/
build/old-w7-asar/
build/electron-win7/
build/pages-deploy/
build/*.bak
# 插件依赖与打包产物（artifacts 由插件自身构建脚本重建，本地构建前若缺失需先生成）
resources/dsh-plugins/*/node_modules/
resources/dsh-plugins/*/artifacts/

# 插件旧版本备份（如 dshmarket.1.46.0.bak）：换版本时留的本地回滚副本，
# 154 个文件且可随时用 npm 重新取回，不入库。
resources/dsh-plugins/*.bak/
resources/dsh-plugins/*.bak
